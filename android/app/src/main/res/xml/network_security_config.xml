<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly prohibit cleartext HTTP traffic across all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only official platform system certificates, rejecting untrusted user CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
