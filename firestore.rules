rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny rule for zero-trust security
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper functions for security checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // 1. Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
      
      // AI query history
      match /ai_history/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // 2. Posts collection rules
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // 3. Communities collection rules
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // For joining / updating member count, roles or rules
      allow delete: if false;
      
      // Subcollection for real-time community chat messages
      match /chat_messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated();
      }
    }
    
    // 4. Chats collection rules
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        resource == null || 
        request.auth.uid in resource.data.members || 
        request.auth.uid == resource.data.userId
      );
    }
    
    // 5. Voice Rooms rules
    match /voice_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
    
    // 6. Events rules
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
